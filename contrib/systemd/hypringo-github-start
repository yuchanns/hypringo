#!/bin/sh
set -eu

if [ -z "${HYPRINGO_GITHUB_TOKEN:-}" ]; then
	if command -v gh >/dev/null 2>&1; then
		token=$(gh auth token 2>/dev/null || true)
		if [ -n "$token" ]; then
			HYPRINGO_GITHUB_TOKEN=$token
			export HYPRINGO_GITHUB_TOKEN
		fi
	fi
fi

exec "${HYPRINGO_BIN:-"$HOME/.local/bin/hypringo"}" "$@"
