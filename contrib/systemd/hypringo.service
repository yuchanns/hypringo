[Unit]
Description=Hypringo desktop orchestration service
Documentation=https://github.com/yuchanns/hypringo
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=%h/.local/bin/hypringo --check-config
ExecStart=%h/.local/bin/hypringo
ExecReload=%h/.local/bin/hypringo reload
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
KillMode=mixed

[Install]
WantedBy=graphical-session.target
