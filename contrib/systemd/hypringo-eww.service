[Unit]
Description=Hypringo-managed Eww desktop session
Documentation=https://github.com/yuchanns/hypringo
PartOf=graphical-session.target
Wants=hypringo.service
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=%h/.local/bin/hypringo doctor --socket %t/hypringo.sock
ExecStart=%h/.local/bin/hypringo-eww-session
Restart=on-failure
RestartSec=15
TimeoutStopSec=5
KillMode=control-group

[Install]
WantedBy=graphical-session.target
